# Server only. Never copy this file into the desktop application.
HOST=0.0.0.0
PORT=3000
ALLOW_HTTP=true
# Temporary explicit plaintext authentication. Disable after enabling HTTPS.
ALLOW_HTTP_AUTH=true
DB_HOST=SET_ON_SERVER
DB_PORT=3306
DB_USER=SET_ON_SERVER
DB_NAME=SET_ON_SERVER
DB_PASSWORD=SET_ON_SERVER
# Optional path to the hosting provider's MySQL CA certificate.
DB_SSL_CA=
# Optional permanent direct ZIP download URLs. Empty = serve local downloads/ files.
DOWNLOAD_MAC_URL=
DOWNLOAD_WINDOWS_URL=

# Public origin for this temporary HTTP deployment.
PUBLIC_URL=http://185.173.93.200:3000
DEV_ALLOW_INSECURE_AUTH=false
RESEND_API_KEY=
MAIL_FROM="AppRevive <noreply@YOUR_DOMAIN>"
# Payment processing is disabled until explicitly configured.
APP_ENV=production
PAYMENTS_ENABLED=false
# Test payments are accepted only with APP_ENV=staging, never production.
PAYMENTS_TEST_MODE=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Set the correct receipt VAT code for your merchant configuration.
PAYMENT_VAT_CODE=
PAYMENT_TAX_SYSTEM_CODE=
# Initial fallback only. Admin dashboard policy overrides it for future sales.
PARTNER_COMMISSION_BPS=0
PARTNER_HOLD_DAYS=14

# Public legal details of the individual entrepreneur. Never use DB credentials here.
# Missing values keep documents explicitly marked as drafts and excluded from indexing.
LEGAL_OPERATOR_NAME=""
LEGAL_OPERATOR_INN=""
LEGAL_OPERATOR_OGRNIP=""
LEGAL_OPERATOR_ADDRESS=""
LEGAL_CONTACT_EMAIL=""
LEGAL_DATA_LOCATION=""
