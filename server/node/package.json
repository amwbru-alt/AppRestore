{
  "name": "apprevive-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "doctor": "node --env-file=.env src/run-doctor.mjs",
    "migrate": "node --env-file=.env src/migrate.mjs",
    "start": "node --env-file=.env src/index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "sync-icons": "node --env-file=.env src/manage.mjs sync-icons",
    "add-codes": "node --env-file=.env src/manage.mjs add-codes",
    "configure-http": "node src/configure-http.mjs"
  },
  "dependencies": {
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "jsdom": "30.1.3"
  }
}
